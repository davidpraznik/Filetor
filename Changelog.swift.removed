import SwiftUI

struct ChangeEntry: Identifiable {
    let version: String
    let date: String
    let notes: [String]
    var id: String { version }
}

enum Changelog {
    /// Newest first. Add an entry here for every release.
    static let entries: [ChangeEntry] = [
        ChangeEntry(version: "0.1.0", date: "7. 11. 2026", notes: [
            "First native version: dual pane browser with tabs, breadcrumbs and a draggable divider.",
            "List, Icons and Columns views, column chooser, filter and hidden files.",
            "Copy and move between panes with progress, conflict handling and drag and drop.",
            "Customizable toolbar, text size, appearance and accent colour.",
            "Drop Stack, AirDrop, Connect to Server and mounted volumes in the sidebar.",
        ]),
    ]
}

struct VersionsSheet: View {
    @Environment(\.dismiss) private var dismiss
    @AppStorage("textSize") private var textSize = 1
    private var s: CGFloat { UIScale.value(textSize) }

    private var installed: String {
        Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String ?? "?"
    }

    var body: some View {
        VStack(alignment: .leading, spacing: 14) {
            Text("Versions").font(.system(size: 22 * s))
            Text("Installed version: \(installed)").foregroundStyle(.secondary)
            ScrollView {
                VStack(alignment: .leading, spacing: 18 * s) {
                    ForEach(Changelog.entries) { e in
                        VStack(alignment: .leading, spacing: 6 * s) {
                            HStack(spacing: 6) {
                                Text(e.version).fontWeight(.semibold)
                                Text("· " + e.date).foregroundStyle(.secondary)
                            }
                            ForEach(e.notes, id: \.self) { n in
                                HStack(alignment: .firstTextBaseline, spacing: 8) {
                                    Text("•").foregroundStyle(.secondary)
                                    Text(n).fixedSize(horizontal: false, vertical: true)
                                }
                            }
                        }
                    }
                }
                .frame(maxWidth: .infinity, alignment: .leading)
            }
            .frame(height: 300 * s)
            HStack {
                Spacer()
                Button("Done") { dismiss() }
                    .buttonStyle(PathsButtonStyle(scale: s, prominent: true))
                    .keyboardShortcut(.defaultAction)
            }
        }
        .font(.system(size: 13 * s))
        .padding(28)
        .frame(width: 560 * s)
    }
}
